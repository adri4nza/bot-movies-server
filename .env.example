# ── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-tu-token-de-botfather

# ── Google Gemini ─────────────────────────────────────────
GEMINI_API_KEY=tu-api-key-de-google-ai-studio
# Modelo configurable (evita hardcodear uno que pueda deprecarse).
GEMINI_MODEL=gemini-2.5-flash

# ── Radarr ────────────────────────────────────────────────
RADARR_URL=http://radarr:7878
RADARR_API_KEY=tu-api-key-de-radarr

# ── Sonarr ────────────────────────────────────────────────
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=tu-api-key-de-sonarr

# ── Red ───────────────────────────────────────────────────
# Proxy SOCKS de Warp (solo afecta el tráfico hacia Gemini).
WARP_PROXY=socks5://warp:1080
# Timeout en segundos para todas las llamadas HTTP.
HTTP_TIMEOUT=30


DUCKDNS_TOKEN=token-sacado-de-dominio-duckdns